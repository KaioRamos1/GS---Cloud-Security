[Unit]
Description=Minhas Tarefas API (Bun + SQLite)
After=network.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/opt/minhas-tarefas
ExecStart=/home/azureuser/.bun/bin/bun run /opt/minhas-tarefas/src/index.ts
Environment=PORT=80
Environment=HOST=0.0.0.0
Environment=TODO_API_DB_PATH=/var/lib/minhas-tarefas/tasks.sqlite3
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
